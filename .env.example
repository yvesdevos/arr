# ---------------------------------------------------------------------------
# arr stack on TrueNAS 25.10 — copy to .env and fill in.
# .env is gitignored. Never commit it.
# ---------------------------------------------------------------------------

# ----- Pools and datasets ---------------------------------------------------
# Pool names exactly as shown in the TrueNAS UI (no leading /mnt/).
SSD_POOL=ssd
HDD_POOL=tank

# Parent dataset for app configs. Created by scripts/create-datasets.sh.
# One child dataset per service is created under it (radarr, sonarr, ...).
# The compose file and this .env should live in /mnt/${APPS_DATASET}.
APPS_DATASET=${SSD_POOL}/apps/arr

# Your existing media dataset. Must already exist. Not recreated.
MEDIA_DATASET=${HDD_POOL}/media

# Sub-folders inside the media dataset. Created if missing (folders, not
# datasets, so hardlinks keep working). Space separated.
MEDIA_SUBDIRS="downloads/complete downloads/incomplete movies tv"

# Where the media dataset is mounted INSIDE every container.
# Set this to whatever your old Radarr/Sonarr root folders started with
# (e.g. /media or /data) and you won't have to re-map anything.
MEDIA_MOUNT=/data

# Your existing downloads dataset (complete/ and incomplete/ inside it).
# Mounted at DOWNLOADS_MOUNT in Transmission, qBittorrent, Radarr and Sonarr.
# Set the mount to the path your old Transmission used (settings.json:
# download-dir) and give qBittorrent the same paths.
DOWNLOADS_DATASET=${HDD_POOL}/downloads
DOWNLOADS_MOUNT=/downloads

# ----- Plex -------------------------------------------------------------------
# RAM-backed tmpfs for transcoding. Mounted inside the Plex container at
# PLEX_TRANSCODE_MOUNT; set that same path in Plex > Settings > Transcoder >
# "Transcoder temporary directory". If your old app already used a path,
# use that one here so the migrated setting keeps working.
# Size accepts m/g suffixes. This RAM is only used while transcoding.
PLEX_TRANSCODE_MOUNT=/transcode
PLEX_TRANSCODE_SIZE=16384m

# Resource limits. Subtitle burn-in transcodes are memory hungry; these
# values were found by testing. Keep PLEX_MEMORY well above
# PLEX_TRANSCODE_SIZE: tmpfs pages count against the container's limit.
PLEX_CPUS=6
PLEX_MEMORY=24576m

# ----- Identity ---------------------------------------------------------------
# 568:568 is the TrueNAS "apps" user. Use the same for all services so
# hardlinks and permissions are consistent across the stack.
PUID=568
PGID=568
UMASK=002
TZ=Europe/Brussels

# ----- Host ports -------------------------------------------------------------
# Change if something else on the NAS already uses one of these.
PORT_RADARR=7878
PORT_SONARR=8989
PORT_PROWLARR=9696
PORT_TRANSMISSION=9091
PORT_TRANSMISSION_PEER=51413
PORT_QBITTORRENT=8080
# Must differ from PORT_TRANSMISSION_PEER while both clients run. Once
# Transmission is gone, set this to 51413 to reuse the router forward.
PORT_QBITTORRENT_PEER=6881
PORT_QUI=7476
PORT_PLEX=32400
PORT_SEERR=5055
PORT_FLARESOLVERR=8191
PORT_PROFILARR=6868
PORT_NEWTARR=9705
PORT_DOZZLE=9999

# ----- Secrets ----------------------------------------------------------------
# Only needed on first boot of a fresh Plex config. Leave empty when migrating
# an existing Plex volume. Get one at https://www.plex.tv/claim (valid 4 min).
PLEX_CLAIM=

# Transmission web UI auth. Leave both empty to disable auth (LAN only!).
TRANSMISSION_USER=
TRANSMISSION_PASS=
# qBittorrent and qui keep their own credentials; nothing to set here. See
# README.md "Switching to qBittorrent and qui" for the first-run password.

# ----- Migration sources ------------------------------------------------------
# Used by scripts/migrate-volumes.sh. Paths to the OLD app config volumes.
# For TrueNAS-managed ixVolumes look under /mnt/.ix-apps/app_mounts/<app>/.
# Leave a line empty to skip that service.
OLD_RADARR_CONFIG=/mnt/.ix-apps/app_mounts/radarr/config
OLD_SONARR_CONFIG=/mnt/.ix-apps/app_mounts/sonarr/config
OLD_PROWLARR_CONFIG=/mnt/.ix-apps/app_mounts/prowlarr/config
OLD_PLEX_CONFIG=/mnt/.ix-apps/app_mounts/plex/config
OLD_TRANSMISSION_CONFIG=/mnt/.ix-apps/app_mounts/transmission/config
