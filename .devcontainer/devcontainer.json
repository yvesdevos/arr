// generated by devshared — edit kit.json or *.extra.*
{
  "name": "${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "remoteUser": "node",
  "init": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=nm-${localWorkspaceFolderBasename}-${devcontainerId},target=${localWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown node:node node_modules && if [ -f package-lock.json ]; then npm ci; elif [ -f package.json ]; then npm install; fi",
  "shutdownAction": "stopContainer",
  "features": {
    "ghcr.io/yvesdevos/devcontainer-kit/personal:1": {}
  }
}
